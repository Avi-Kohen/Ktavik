# Normalize line endings for everyone who clones this repo.
#
# Why a .gitattributes and not `core.autocrlf`: core.autocrlf is a per-machine
# git config. It does not travel with the repository, so a second machine — or a
# contributor — silently gets different behaviour. Attributes are committed, so
# the rule is part of the project.

# Git decides what is text, stores LF in the object database, and checks out LF.
* text=auto eol=lf

# Windows shell scripts must keep CRLF or they will not run.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Gradle wrapper: the shell script must stay LF even on Windows.
gradlew      text eol=lf
gradlew.bat  text eol=crlf

# Explicitly binary — never diff, never normalize.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.pt     binary
*.pth    binary
*.ckpt   binary
*.onnx   binary
*.tflite binary
*.jar    binary
*.keystore binary

# Collapse generated lockfiles in diffs and pull requests.
uv.lock linguist-generated=true
